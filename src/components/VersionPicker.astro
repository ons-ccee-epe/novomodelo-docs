---
// Architecture B version picker — overrides Starlight's `SocialIcons` slot.
// Each build knows its own base via import.meta.env.BASE_URL ("/docs/" or
// "/docs/vX.Y/"), so the picker marks the current version and links across the
// sibling builds; version-options.ts decides which versions a page lists, where
// each option leads and how each one reads.
// A single option renders as plain text instead of a select.
import versions from "../../versions.json";
import { entryLabel, versionOptions } from "./version-options";

const pt = (Astro.currentLocale ?? "en").toLowerCase().startsWith("pt");
const { current, options } = versionOptions(versions, import.meta.env.BASE_URL, pt);
const hint = pt
  ? "Versão do Novo Modelo que esta documentação descreve"
  : "novomodelo release this documentation describes";
---

{
  options.length > 1 ? (
    <select class="version-picker" title={hint} aria-label={hint}>
      {options.map((o) => (
        <option value={o.value} selected={o.selected}>
          {o.label}
        </option>
      ))}
    </select>
  ) : (
    <span class="version-picker" title={hint}>
      {entryLabel(versions, current, pt)}
    </span>
  )
}

<script>
  const sel = document.querySelector<HTMLSelectElement>("select.version-picker");
  sel?.addEventListener("change", (event) => {
    const target = event.currentTarget;
    if (target instanceof HTMLSelectElement) {
      window.location.href = target.value;
    }
  });
</script>

<style>
  .version-picker {
    font-size: var(--sl-text-xs);
    white-space: nowrap;
  }
  span.version-picker {
    color: var(--sl-color-gray-3);
  }
  select.version-picker {
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.4rem;
  }
</style>
