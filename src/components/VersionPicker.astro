---
// Architecture B version picker — overrides Starlight's `SocialIcons` slot.
// Each build knows its own base via import.meta.env.BASE_URL ("/" or "/vX.Y/"),
// so the picker marks the current version and links across the sibling builds.
// The select renders only when it has more than one option; the version text always shows.
import versions from "../../versions.json";

const norm = (b: string): string => (b.endsWith("/") ? b : b + "/");
const current = norm(import.meta.env.BASE_URL);
const all = [versions.latest, ...versions.versions];
const currentEntry = all.find((v) => norm(v.base) === current) ?? all[0];
const pt = (Astro.currentLocale ?? "en").toLowerCase().startsWith("pt");
const shown = pt ? [currentEntry] : all;
// English readers of latest stay in English: its English home is under en/.
// A frozen snapshot is English only and keeps its base.
const optionValue = (v: { base: string }): string =>
  !pt && v === versions.latest ? `${norm(v.base)}en/` : v.base;
const hasChoice = shown.length > 1;
const Wrapper = hasChoice ? "label" : "div";
---

<Wrapper class="version-picker" title={pt ? "Versão da documentação" : "Documentation version"}>
  <span class="version-picker__label">{pt ? "Versão" : "Version"}: {currentEntry.label}</span>
  {
    currentEntry.novomodelo && (
      <span
        class="version-picker__novomodelo"
        title={pt ? "versão do Novo Modelo descrita nestas páginas" : "novomodelo release these pages describe"}
      >
        {pt ? "documenta o Novo Modelo" : "documents novomodelo"} {currentEntry.novomodelo}
      </span>
    )
  }
  {
    hasChoice && (
      <select
        class="version-picker__select"
        aria-label={pt ? "Selecionar versão da documentação" : "Select documentation version"}
      >
        {
          shown.map((v) => (
            <option value={optionValue(v)} selected={norm(v.base) === current}>
              {v.label}
            </option>
          ))
        }
      </select>
    )
  }
</Wrapper>

<script>
  const sel = document.querySelector<HTMLSelectElement>(
    ".version-picker__select",
  );
  sel?.addEventListener("change", (event) => {
    const target = event.currentTarget;
    if (target instanceof HTMLSelectElement) {
      window.location.href = target.value;
    }
  });
</script>

<style>
  .version-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sl-text-xs);
  }
  .version-picker__label {
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .version-picker__novomodelo {
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .version-picker__select {
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    padding: 0.15rem 0.4rem;
  }
</style>
