---
// Footer override (E10 ticket-031) — wraps Starlight's default Footer so the
// EditLink / LastUpdated / Pagination slots are fully preserved, then appends
// two base-aware footer notices: the third-party notices link, and the
// content/code-license line (the latter added by ticket-034).
//
// Base-URL normalisation mirrors the idiom from VersionPicker.astro:
//   const norm = (b) => (b.endsWith("/") ? b : b + "/");
// This ensures the href is correct for both root builds (BASE_URL="/")
// and versioned builds (BASE_URL="/vX.Y/").
//
// Both notices are <p class="sl-footer-notice"> blocks inside the
// .sl-footer-notices wrapper below; add any further notice the same way.
import Default from "@astrojs/starlight/components/Footer.astro";

const norm = (b: string): string => (b.endsWith("/") ? b : b + "/");
const base = norm(import.meta.env.BASE_URL);
const noticesHref = base + "THIRD-PARTY-NOTICES.txt";
---

<Default><slot /></Default>
<div class="sl-footer-notices">
  <p class="sl-footer-notice">
    <a href={noticesHref}>Third-party notices</a>
  </p>
  <p class="sl-footer-notice">
    © 2026 Operador Nacional do Sistema Elétrico - ONS, Câmara de Comercialização
    de Energia Elétrica - CCEE, Empresa de Pesquisa Energética - EPE and
    Contributors, adapted from the
    <a href="https://github.com/cobre-rs/cobre-docs">Cobre Documentation</a>
    © 2026 Rogerio J. M. Alves and Cobre Contributors — licensed under
    <a href="https://github.com/ons-ccee-epe/novomodelo-docs/blob/main/LICENSE">Apache-2.0</a>
  </p>
</div>

<style>
  .sl-footer-notices {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-6);
    text-align: center;
  }
  .sl-footer-notice {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .sl-footer-notice a {
    color: var(--sl-color-gray-3);
    text-decoration: underline;
  }
  .sl-footer-notice a:hover {
    color: var(--sl-color-white);
  }
</style>

<script>
  // Diagram sizing. astro-d2 wraps each diagram in a RESPONSIVE outer <svg>
  // (viewBox, no width) that fills the content column and stretches a small
  // diagram up — oversized shapes/text. Pin each `.d2-fig` figure to its NATIVE
  // px size (from the viewBox) so it renders 1:1 (text at its authored ~16px);
  // the `.d2-fig` box (overflow-x:auto, src/styles/diagrams.css) then scrolls a
  // diagram wider than the column instead of shrinking it. Pure CSS can't reach
  // the native size through the nested-svg wrapper, hence this tiny script.
  function sizeD2Figures() {
    document.querySelectorAll(".d2-fig > svg").forEach((svg) => {
      const vb = (svg.getAttribute("viewBox") || "").trim().split(/\s+/).map(Number);
      if (vb.length === 4 && vb[2] > 0 && vb[3] > 0) {
        (svg as SVGElement).style.width = vb[2] + "px";
        (svg as SVGElement).style.height = vb[3] + "px";
      }
    });
  }
  sizeD2Figures();
  // Re-run after client-side (view-transition) navigations, if enabled.
  document.addEventListener("astro:page-load", sizeD2Figures);
</script>
