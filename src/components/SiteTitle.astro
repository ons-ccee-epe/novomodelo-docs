---
// SiteTitle override: the hotsite's wordmark (brand mark + name) and the three
// institutional logos, on the graphite header (docs/design/design-system.md
// §8 and §9, D4). Colours come from tokens.css; the logos are the hotsite's
// white PNGs, shown on wide screens only so the search and pickers keep room.
import ccee from "../assets/logos/ccee-branca.png";
import epe from "../assets/logos/epe-branca.png";
import ons from "../assets/logos/ons-branca.png";

const { siteTitle, siteTitleHref, lang } = Astro.locals.starlightRoute;
const pt = lang?.toLowerCase().startsWith("pt");
const sub = pt ? "Documentação" : "Documentation";
const logosLabel = pt ? "Instituições responsáveis" : "Responsible institutions";
---

<a href={siteTitleHref} class="site-title nm-brand" aria-label={siteTitle}>
  <span class="nm-brand__mark" aria-hidden="true">NM</span>
  <span class="nm-brand__text" aria-hidden="true">
    <span class="nm-brand__name" translate="no">Novo Modelo</span>
    <span class="nm-brand__sub">{sub}</span>
  </span>
</a>
<ul class="nm-logos" aria-label={logosLabel}>
  <li><img class="nm-logo nm-logo--ccee" src={ccee.src} width={ccee.width} height={ccee.height} alt="CCEE – Câmara de Comercialização de Energia Elétrica" /></li>
  <li><img class="nm-logo nm-logo--epe" src={epe.src} width={epe.width} height={epe.height} alt="EPE – Empresa de Pesquisa Energética" /></li>
  <li><img class="nm-logo nm-logo--ons" src={ons.src} width={ons.width} height={ons.height} alt="ONS – Operador Nacional do Sistema Elétrico" /></li>
</ul>

<style>
  .nm-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .nm-brand__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  .nm-brand__text {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .nm-brand__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
  }
  .nm-brand__sub {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .nm-brand:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Logos: the hotsite's optical sizes (design-system.md §8), wide screens only */
  .nm-logos {
    display: none;
    align-items: center;
    gap: 1.25rem;
    margin: 0 0 0 var(--space-3);
    padding: 0 0 0 var(--space-3);
    list-style: none;
    border-inline-start: 1px solid var(--color-border-dark);
  }
  .nm-logos li {
    display: flex;
    margin: 0;
  }
  .nm-logo {
    width: auto;
  }
  .nm-logo--ons {
    height: 22px;
  }
  .nm-logo--ccee {
    height: 14px;
  }
  .nm-logo--epe {
    height: 24px;
  }
  @media (min-width: 90rem) {
    .nm-logos {
      display: flex;
    }
  }
</style>
