---
import { ICONS } from './icons';
interface Props { family: 'equipment' | 'network' | 'hydrology' | 'rules'; icon: string; lead: string }
const { family, icon, lead } = Astro.props;
---
<div class={`entity-hero entity-${family}`}>
  <span class="entity-hero__icon">
    <svg aria-hidden="true" focusable="false" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon] ?? ''} />
  </span>
  <p class="entity-hero__lead">{lead}</p>
</div>
