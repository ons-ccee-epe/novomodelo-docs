---
import { key } from '../entities';
interface Props { lang?: 'en' | 'pt-BR' }
const lang = Astro.props.lang ?? Astro.currentLocale ?? 'en';
const k = key(lang);
const T = k === 'pt' ? {
  title: 'Uma árvore de aberturas, dois modos de percorrê-la',
  stage: 'Estágio', node: 'nó', op: 'aberturas do nó',
  fwd: 'Simulação forward', fwdb: 'sorteia uma abertura por estágio|(dentro da amostra, o padrão) e segue um único caminho',
  bwd: 'Simulação backward', bwdb: 'avalia todas as aberturas de cada nó|nos estados visitados pela simulação forward',
  note: 'As aberturas são geradas uma vez, antes do treinamento, e ficam fixas.',
  aria: 'Quatro colunas, uma por estágio. Cada coluna tem um nó no alto e, abaixo, quatro aberturas. Uma linha destacada passa por uma abertura em cada estágio: a simulação forward segue um único caminho. No último estágio, as quatro aberturas estão ligadas ao nó por setas: a simulação backward avalia todas as aberturas de cada nó, nos estados visitados pela simulação forward.',
  cap_: 'Figura: a mesma árvore de aberturas vista pela simulação forward e pela simulação backward, no esquema dentro da amostra (o padrão). Ilustração esquemática.',
} : {
  title: 'One opening tree, two ways to walk it',
  stage: 'Stage', node: 'node', op: 'openings of the node',
  fwd: 'Forward pass', fwdb: 'draws one opening per stage|(in-sample, the default) and follows a single path',
  bwd: 'Backward pass', bwdb: 'evaluates every opening of each node|at the states visited by the forward simulation',
  note: 'Openings are generated once, before training, and stay fixed.',
  aria: 'Four columns, one per stage. Each column has a node at the top and four openings below it. A highlighted line passes through one opening in each stage: the forward pass follows a single path. In the last stage the four openings are linked to the node by arrows: the backward pass evaluates every opening of each node at the states visited by the forward simulation.',
  cap_: 'Figure: the same opening tree seen by the forward pass and by the backward pass, under the in-sample scheme (the default). Schematic illustration.',
};
const cols = [110, 310, 510, 710];
const rows = [140, 180, 220, 260];
const pick = [1, 2, 0, 2];
---
<figure class="entity-illustration entity-hydrology">
  <svg viewBox="0 0 860 410" role="img" aria-label={T.aria}>
    <text x="20" y="26" font-size="15" font-weight="600" style="fill: var(--ent-hydrology-fg)">{T.title}</text>
    {cols.map((x, c) => (
      <g>
        <text x={x} y="56" text-anchor="middle" font-size="13" font-weight="600">{T.stage} {c + 1}</text>
        <circle cx={x} cy="90" r="16" fill="var(--ent-hydrology-bg)" stroke="var(--ent-hydrology)" stroke-width="2" />
        <text x={x} y="94" text-anchor="middle" font-size="11" style="fill: var(--ent-hydrology-fg)">{T.node}</text>
        <rect x={x - 28} y="120" width="56" height="160" rx="10" fill="none" stroke="var(--sl-color-gray-4)" stroke-dasharray="4 4" />
        {rows.map((y, r) => <circle cx={x} cy={y} r="8" fill={pick[c] === r ? 'var(--ent-hydrology)' : 'var(--sl-color-gray-5)'} stroke="var(--ent-hydrology)" stroke-width="1.5" />)}
      </g>
    ))}
    <polyline points={cols.map((x, c) => `${x},${rows[pick[c]]}`).join(' ')} fill="none" stroke="var(--ent-hydrology)" stroke-width="3" stroke-linejoin="round" />
    <g stroke="var(--ent-hydrology)" stroke-width="1.5" fill="none">
      {rows.map((y) => <path d={`M${cols[3] + 34} ${y} Q${cols[3] + 70} ${y} ${cols[3] + 70} 110 L${cols[3] + 24} 94`} />)}
    </g>
    <text x="20" y="312" font-size="13" font-weight="600">{T.fwd}</text>
    <text x="20" y="330" font-size="12" style="fill: var(--sl-color-gray-2)">{T.fwdb.split("|").map((l, i) => <tspan x="20" dy={i ? 14 : 0}>{l}</tspan>)}</text>
    <text x="440" y="312" font-size="13" font-weight="600">{T.bwd}</text>
    <text x="440" y="330" font-size="12" style="fill: var(--sl-color-gray-2)">{T.bwdb.split("|").map((l, i) => <tspan x="440" dy={i ? 14 : 0}>{l}</tspan>)}</text>
    <text x="20" y="386" font-size="12" style="fill: var(--sl-color-gray-2)">{T.note}</text>
  </svg>
  <figcaption>{T.cap_}</figcaption>
</figure>
