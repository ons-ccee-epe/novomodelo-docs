---
interface Props { items: { kind: string; title: string; href: string }[] }
const { items } = Astro.props;
---
<div class="entity-deeplinks">
  {items.map((i) => (
    <a class="entity-deeplink" href={i.href}><span class="entity-deeplink__kind">{i.kind}</span><strong>{i.title}</strong></a>
  ))}
</div>
