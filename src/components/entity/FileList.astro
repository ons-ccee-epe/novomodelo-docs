---
import { t } from './i18n';
interface Props { items: { dir: 'in' | 'out'; path: string; href: string }[] }
const { items } = Astro.props;
const locale = Astro.currentLocale;
---
<div class="entity-files">
  <p class="entity-files__lead">{t(locale, 'filesLead')}</p>
  <ul class="entity-files__list">
    {items.map((i) => (
      <li><a class="entity-file" href={i.href}><span class={`entity-file__dir entity-file__dir--${i.dir}`}>{t(locale, i.dir === 'in' ? 'input' : 'output')}</span> <code>{i.path}</code></a></li>
    ))}
  </ul>
</div>
