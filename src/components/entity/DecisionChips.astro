---
interface Props { items: { label: string; unit?: string }[]; note?: string; family?: 'equipment' | 'network' | 'hydrology' | 'rules' }
const { items, note, family = 'hydrology' } = Astro.props;
---
<div class={`entity-chips-wrap entity-${family}`}>
  <ul class="entity-chips">
    {items.map((i) => (
      <li class="entity-chip">{i.label}{i.unit && <> <span aria-hidden="true">·</span> <span class="entity-chip__unit">{i.unit}</span></>}</li>
    ))}
  </ul>
  {note && <p class="entity-note">{note}</p>}
</div>
